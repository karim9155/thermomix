# Supabase project (catalog reads + order writes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — never prefix with NEXT_PUBLIC_, never import into a 'use client' file.
SUPABASE_SECRET_KEY=

# Resend (order confirmation to the customer + notification to the shop).
# Leave empty in development — orders still work, emails are just logged
# and skipped.
RESEND_API_KEY=
# The From address. Must be on a domain verified in Resend, otherwise
# every send is rejected. Defaults to INOCASA <commandes@inocasa.tn>.
# RESEND_FROM_EMAIL=
# Where the "new order" notification goes. Defaults to contact@inocasa.tn.
# ORDER_NOTIFICATION_EMAIL=

# Payment provider: "stub" (default, local mock at /paiement-simule) or "paymee"
PAYMENT_PROVIDER=stub

# Required only when PAYMENT_PROVIDER=paymee
PAYMEE_API_KEY=

# Public base URL used to build absolute redirect/webhook URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authenticates Vercel Cron's call to /api/keepalive (see vercel.json).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must also be set in the Vercel dashboard under Project Settings →
# Environment Variables — the cron sends it as a Bearer token, and the
# route rejects the request without a match.
CRON_SECRET=
