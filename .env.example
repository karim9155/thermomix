# Supabase project (catalog reads + order writes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — never prefix with NEXT_PUBLIC_, never import into a 'use client' file.
SUPABASE_SECRET_KEY=

# OVH Email Pro SMTP (order confirmation to the customer + notification to
# the shop). Leave empty in development — orders still work, emails are
# just logged and skipped.
#
# SMTP_USER must be the full mailbox address: OVH rejects a From that
# doesn't match the authenticated account.
SMTP_USER=contact@inocasa.tn
SMTP_PASSWORD=
# Defaults below match OVH Email Pro; only set them if yours differ.
# SMTP_HOST=pro3.mail.ovh.net
# SMTP_PORT=587
# Where the "new order" notification goes. Defaults to contact@inocasa.tn.
# ORDER_NOTIFICATION_EMAIL=

# Payment provider: "stub" (default, local mock at /paiement-simule) or "paymee"
PAYMENT_PROVIDER=stub

# Required only when PAYMENT_PROVIDER=paymee
PAYMEE_API_KEY=

# Public base URL used to build absolute redirect/webhook URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
